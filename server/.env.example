PORT=3001
HOST=0.0.0.0
API_BASE_URL=http://10.1.1.198:9000
# Documentação oficial: https://servicosflex.rpinfo.com.br:7443/v1.0/documentacao?location=documentacao#/
# Resumo no projeto: server/docs/API-ERP.md
API_USUARIO=seu_usuario_api
API_SENHA=sua_senha_api
AUTH_TOKEN_HEADER=token

PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=superama

# WR PDV — vendas e cupons (substitui API /clientes/.../vendas)
WRPDV_HOST=10.1.1.250
WRPDV_PORT=5432
WRPDV_USER=consulta
WRPDV_PASSWORD=consulta
WRPDV_DATABASE=wrpdv

SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria-com-minimo-32-caracteres
ADMIN_SESSION_SECRET=outra-chave-longa-somente-para-o-painel-admin
SESSION_EXPIRES_IN=7d
ADMIN_USUARIO=admin
# Na primeira subida, o usuário acima é importado para a tabela painel_admin.
# Depois, cadastre mais administradores em Admin → Administradores.
# Prefira hash bcrypt (npm run hash-admin-senha no diretório server):
# ADMIN_SENHA_HASH=$2b$12$...
ADMIN_SENHA=troque-esta-senha
ADMIN_SESSION_EXPIRES_IN=8h

# Segurança HTTP (produção): origens permitidas, separadas por vírgula
# CORS_ORIGINS=https://clube.seudominio.com.br,http://localhost:5173
# TRUST_PROXY_HOPS=1
# RATE_LIMIT_AUTH_MAX=40
# RATE_LIMIT_CPF_MAX=25
# RATE_LIMIT_ADMIN_MAX=15
# NODE_ENV=production

# E-mail (Gmail) — recuperação de senha
# Use senha de app do Google (Conta Google → Segurança → Senhas de app)
# APP_PUBLIC_URL=https://clube.mercadosuperama.com.br
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="Clube Superama+ <seu-email@gmail.com>"
# EMAIL_LOGO_URL=https://clube.mercadosuperama.com.br/logo.png
# MERCADO_PUBLIC_URL=https://mercadosuperama.com.br
# RECUPERAR_SENHA_TTL_MIN=30
# RECUPERAR_SENHA_MAX_TENTATIVAS=5
# RECUPERAR_SENHA_COOLDOWN_SEG=90
# RECUPERAR_SENHA_MAX_HORA=3
# RATE_LIMIT_RECUPERAR_SOLICITAR_MAX=8
# RATE_LIMIT_RECUPERAR_REDEFINIR_MAX=12

